// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum cadence_preference {
  daily
  weekly
  monthly
}

model User {
  id          String             @id @default(uuid())
  name        String
  profession  String?
  dob         DateTime?
  preference  cadence_preference @default(daily)
  email       String             @unique
  password    String
  journal_pin String?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @default(now())
  deleted_at  DateTime?
  sessions    Session[]
  consents    Consent[]
  entries     Entry[]
  themes      Theme[]
  insights    Insight[]
}

model Session {
  id            String    @id @default(uuid())
  refresh_token String
  created_at    DateTime  @default(now())
  expired_at    DateTime
  revoked_at    DateTime?
  user          User      @relation(fields: [userId], references: [id])
  userId        String
}

enum Consent_Type {
  terms
  data_processing
  training_use
}

model Consent {
  id         String       @id @default(uuid())
  type       Consent_Type
  granted_at DateTime     @default(now())
  revoked_at DateTime
  user       User         @relation(fields: [userId], references: [id])
  userId     String
}

model Entry {
  id         String                      @id @default(uuid())
  content    String
  embedding  Unsupported("vector[1536]")
  created_at DateTime                    @default(now())
  deleted_at DateTime
  themes     Theme[]
  user       User                        @relation(fields: [userId], references: [id])
  userId     String
}

enum Theme_status {
  building
  consistent
  surfaced
}

model Theme {
  id              String       @id @default(uuid())
  label           String
  emotion_tags    String[]
  occurence_count Int
  status          Theme_status
  first_seen_at   DateTime
  last_seen_at    DateTime
  entries         Entry[]
  insights        Insight[]
  user            User         @relation(fields: [userId], references: [id])
  userId          String
}

model Insight {
  id         String   @id @default(uuid())
  content    String
  created_at DateTime @default(now())
  viewed_at  DateTime
  theme      Theme    @relation(fields: [themeId], references: [id])
  themeId    String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
}
